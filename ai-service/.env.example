# AI Service Environment
# Copy to .env and fill in values

# MongoDB
MONGO_URI=mongodb://localhost:27017/log_anomaly_platform

# API Security
API_KEY=dev-ai-service-key-change-me

# LLM Provider (openai, azure, ollama, or mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# For Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# For Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Model settings
MODEL_DEVICE=cpu
ANOMALY_THRESHOLD=0.35
